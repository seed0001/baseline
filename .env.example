# Railway: reference this from the PostgreSQL service as
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/database

# Production should fail closed instead of serving the bundled initial snapshot
# during a database outage.
REQUIRE_DATABASE=true

# Used once with `npm run employee:bootstrap` to create the first owner.
OWNER_NAME=Business Owner
OWNER_EMAIL=owner@your-domain.com
OWNER_PASSWORD=replace-with-a-long-random-password
